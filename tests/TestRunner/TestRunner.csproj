<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>TestRunner.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 构建但不引用：合成插件 DLL 供 ModStoreTests 经假服务器分发后动态加载 -->
    <ProjectReference Include="../TestPlugin/TestPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../runtime/src/Game.Mod.Contract/Game.Mod.Contract.csproj" />
    <ProjectReference Include="../../runtime/src/Game.ECS/Game.ECS.csproj" />
    <ProjectReference Include="../../runtime/src/Game.Messaging/Game.Messaging.csproj" />
    <ProjectReference Include="../../runtime/src/Game.Mod.Runtime/Game.Mod.Runtime.csproj" />
    <Compile Include="../../mods/com.game.core/src/**/*.cs" />
    <Compile Include="../../mods/com.game.network/src/**/*.cs" />
    <!-- Relay 两端线格式互通测试：relay_server 源码编进共享测试程序集（§8.3），零依赖独立可编译 -->
    <Compile Include="../../relay_server/src/RelayServer/**/*.cs" Exclude="../../relay_server/src/RelayServer/Program.cs;../../relay_server/src/RelayServer/Properties/**;**/obj/**;**/bin/**" />
    <Compile Include="../../mods/com.game.ui/src/**/*.cs" />
    <Compile Include="../../mods/com.game.modstore/src/**/*.cs" Exclude="../../mods/com.game.modstore/src/ModStoreView.cs" />
    <Compile Include="../../mods/com.sample.pushbox/src/**/*.cs" Exclude="../../mods/com.sample.pushbox/src/PushBoxView.cs" />
    <Compile Include="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.player/Scripts/**/*.cs" Exclude="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.player/Scripts/PlayerView.cs" />
    <Compile Include="../../samples/Zombtoy/Assets/Mods/com.zombtoy.enemy/Scripts/**/*.cs" Exclude="../../samples/Zombtoy/Assets/Mods/com.zombtoy.enemy/Scripts/EnemyView.cs" />
    <Compile Include="../../samples/Zombtoy/Assets/Mods/com.zombtoy.player/Scripts/**/*.cs" Exclude="../../samples/Zombtoy/Assets/Mods/com.zombtoy.player/Scripts/PlayerView.cs" />
    <Compile Include="../../samples/Zombtoy/Assets/Mods/com.zombtoy.weapon/Scripts/**/*.cs" Exclude="../../samples/Zombtoy/Assets/Mods/com.zombtoy.weapon/Scripts/WeaponView.cs" />
    <Compile Include="../../samples/Zombtoy/Assets/Mods/com.zombtoy.item/Scripts/**/*.cs" Exclude="../../samples/Zombtoy/Assets/Mods/com.zombtoy.item/Scripts/ItemView.cs" />
    <Compile Include="../../samples/Zombtoy/Assets/Mods/com.zombtoy.leaderboard/Scripts/**/*.cs" />
    <Compile Include="../../samples/Zombtoy/Assets/Mods/com.zombtoy.score/Scripts/**/*.cs" />
    <Compile Include="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.weapon/Scripts/**/*.cs" Exclude="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.weapon/Scripts/WeaponView.cs" />
    <Compile Include="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.inventory/Scripts/**/*.cs" Exclude="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.inventory/Scripts/InventoryView.cs" />
    <Compile Include="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.mapgen/Scripts/**/*.cs" Exclude="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.mapgen/Scripts/MapGenView.cs" />
    <Compile Include="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.console/Scripts/**/*.cs" Exclude="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.console/Scripts/ConsoleView.cs" />
    <Compile Include="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.npc/Scripts/**/*.cs" Exclude="../../samples/MirrorUnityFPS/Assets/Mods/com.fps.npc/Scripts/NpcView.cs" />
  </ItemGroup>

</Project>
