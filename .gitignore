# --- dotnet ---
bin/
obj/
*.user
.vs/

# --- Unity 工程（仅 runtime/Unity/ 内） ---
runtime/Unity/[Ll]ibrary/
runtime/Unity/[Tt]emp/
runtime/Unity/[Oo]bj/
runtime/Unity/[Bb]uild/
runtime/Unity/[Bb]uilds/
runtime/Unity/[Ll]ogs/
runtime/Unity/[Uu]ser[Ss]ettings/
runtime/Unity/*.csproj
runtime/Unity/*.sln

# --- built mod packages ---
mods/**/*.mod
mods/**/bin/
mods/**/obj/
.tmp_modbuild/

# --- OS ---
.DS_Store
Thumbs.db

# --- Mirror 依赖（源码 33MB 过大，用 runtime/setup-mirror.sh 获取，不进仓库） ---
third_party/
runtime/Unity/Assets/Mirror/
runtime/Unity/Assets/Mirror.meta

*.log
replica_projects/*
dist/

# === Mod = 独立 Unity 工程（生成物不入库） ===
**/Library/
**/Temp/
**/UserSettings/
**/Logs/
**/obj/
**/AssetBundleBuild/
**/Packages/packages-lock.json
# AssetBundle 构建产物（build-mod-unity.py 可再生）
*.bundle
# Mod 工程内同步的框架 DLL（build-mod-unity.py 拷贝）
mods/**/Assets/Plugins/*.dll
mods/**/Assets/Plugins/*.dll.meta
samples/**/Assets/Plugins/*.dll
samples/**/Assets/Plugins/*.dll.meta
# Mod 工程自动生成的 ProjectSettings（模板仅保留 ProjectVersion.txt）
samples/**/ProjectSettings/*.asset
mods/**/ProjectSettings/*.asset

**/BundleBuild/

# pi 任务编排器运行状态（任务/run/会话文件，不入库）
.harness/
